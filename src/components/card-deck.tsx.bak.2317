    flexDirection: 'column',
    // 暖棕投影：米白底上用黑色投影会发灰
    boxShadow: '0 18px 48px rgba(168, 112, 68, 0.10)',
    willChange: 'transform, opacity'
  },
  // 没翻面：这一块吃掉卡片剩下的高度，把「词 + 音标 + 提示」作为一个整体居中
  centerBlock: {
    flex: 1,
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'center'
  },
  // 翻面后：词在上半区**自己垂直居中**（卡片底部已经用 paddingBottom 给 sheet 留了位置），
  // 这样卡片无论多高，词都落在「sheet 上方那块空间」的正中，不会顶在卡片最上面
  topBlock: {
    flex: 1,
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'center'
  },
  // 点按钮飘出来的小 emoji：在卡片中间偏上，向上浮出画面
  burst: {
    position: 'absolute',
    top: '34%',
    left: '50%',
    marginLeft: '-40rpx',
    width: '80rpx',
    textAlign: 'center',
    fontSize: '60rpx',
    lineHeight: '72rpx',
    animation: 'burstUp 700ms ease-out',
    pointerEvents: 'none',
    zIndex: 20
  },
  // ---------- 释义 sheet（iOS 那种从底部浮上来的玻璃面板）----------
  sheet: {
    position: 'absolute',
    left: 0,
    right: 0,
    bottom: 0,
    height: '320rpx',
    paddingLeft: '40rpx',
    paddingRight: '40rpx',
    paddingTop: '16rpx',
    paddingBottom: '32rpx',
    borderTopLeftRadius: '30rpx',
    borderTopRightRadius: '30rpx',
    backgroundColor: 'rgba(255, 253, 250, 0.88)',
    // 真正让它是「玻璃」的一行；不支持 backdrop-filter 的机型会退化成上面那个 .88 的半透明暖白
    backdropFilter: 'blur(24px) saturate(180%)',
    borderTop: `1px solid ${COLOR.warmLine}`,
